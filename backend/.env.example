PORT=4000
HOST=0.0.0.0
# Copy to ~/pushnhold/.env on EC2. Node listens on 127.0.0.1:4000; Nginx serves HTTPS.
# Postgres is on THIS instance (not RDS).
DATABASE_URL=postgres://cascade:choose-a-strong-password@127.0.0.1:5432/cascade
DATABASE_SSL=false
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=https://cascade.mozartdev.in,http://localhost:5173,http://127.0.0.1:5173

RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# S3 event images — prefer an EC2 instance role (see deploy/s3-instance-policy.json).
# Do NOT set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY if the role is attached.
# Region must match the bucket. Public read: deploy/s3-bucket-public-read.json
AWS_REGION=eu-north-1
S3_BUCKET=YOUR_BUCKET
# Optional CDN: S3_PUBLIC_BASE_URL=https://cdn.example.com

# Resend SMTP — API key IS the SMTP password (username is the word "resend").
# Dashboard: https://resend.com/api-keys  → Create → Sending access → copy re_... once.
# Verify mozartdev.in under Domains, then MAIL_FROM must use that domain.
# Verify mozartdev.in (SPF+DKIM). resend.dev From addresses often go to spam.
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=CASCADE <noreply@mozartdev.in>
MAIL_REPLY_TO=CASCADE <noreply@mozartdev.in>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
